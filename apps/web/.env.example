# Sao chép thành .env.local khi chạy local. Giá trị preview / production đặt trong Vercel Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng trên server (src/lib/supabase/admin.ts). KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_SECRET=
# Salt băm IP cho rate limit lead (chuỗi ngẫu nhiên dài, chỉ server). Không lưu IP thô.
IP_HASH_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chỉ đặt true trên production: preview / staging giữ noindex.
NEXT_PUBLIC_ALLOW_INDEX=false
# Trang pháp lý: tên người vận hành + email liên hệ công khai. Bắt buộc điền trước khi lên store.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Supabase Image Transformation (ảnh thu nhỏ qua /render/image). Gói Free (staging) không có → đặt false để dùng ảnh gốc.
NEXT_PUBLIC_IMAGE_TRANSFORM=true
NEXT_PUBLIC_GOONG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
APP_IOS_TEAM_ID=
APP_IOS_BUNDLE_ID=
APP_ANDROID_PACKAGE=
APP_ANDROID_SHA256=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
