# Sao chép thành .env.local khi chạy local. Giá trị preview / production đặt trong Vercel Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng trên server (src/lib/supabase/admin.ts). KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase Image Transformation (ảnh thu nhỏ qua /render/image). Gói Free (staging) không có → đặt false để dùng ảnh gốc.
NEXT_PUBLIC_IMAGE_TRANSFORM=true
NEXT_PUBLIC_GOONG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
APP_IOS_TEAM_ID=
APP_IOS_BUNDLE_ID=
APP_ANDROID_PACKAGE=
APP_ANDROID_SHA256=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
