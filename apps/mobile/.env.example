# Sao chép thành .env.local khi chạy local. Giá trị staging / production đặt trong EAS Environment Variables.
# Không bao giờ đặt service role key ở đây.
# Supabase local: máy ảo Android dùng http://10.0.2.2:54321; điện thoại thật dùng IP LAN của máy tính (vd http://192.168.1.10:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOONG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_WEB_URL=https://tenapp.vn
# Resize ảnh qua Supabase Image Transformation (mặc định true). Staging (gói Free, không có Transformation) đặt false.
EXPO_PUBLIC_IMAGE_TRANSFORM=true
