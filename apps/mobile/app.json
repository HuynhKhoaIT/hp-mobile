{
  "expo": {
    "name": "Người Dung Quất",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hoaphat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "vn.tenapp.app",
      "associatedDomains": ["applinks:tenapp.vn"]
    },
    "android": {
      "package": "vn.tenapp.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/tin/" },
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/nhom/" },
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/en/tin/" },
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/en/nhom/" },
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/zh/tin/" },
            { "scheme": "https", "host": "tenapp.vn", "pathPrefix": "/zh/nhom/" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6EFFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4F9C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Người Dung Quất truy cập ảnh để bạn chọn ảnh đại diện, ảnh tin đăng và ảnh giấy tờ xác minh.",
          "cameraPermission": "Cho phép Người Dung Quất dùng máy ảnh để bạn chụp giấy tờ xin huy hiệu xác minh.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B4F9C",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
