# Secrets cho Edge Functions. Local: sao chép thành supabase/.env.local rồi
#   pnpm exec supabase functions serve --env-file supabase/.env.local
# Staging / prod: supabase secrets set ... (docs/RUNBOOK.md). Không commit giá trị thật.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY do Supabase cấp sẵn cho function.

# Webhook DB → function (trùng app_settings.webhook_secret; local seed: local-dev-webhook-secret)
WEBHOOK_SECRET=
# Cron → function (pg_cron → purge-files; trùng app_settings.cron_secret; local seed: local-dev-cron-secret)
CRON_SECRET=
# translate-content: Google Cloud Translation v2 API key. Bỏ trống = nút Dịch báo errors.translate_unavailable
TRANSLATE_API_KEY=
# Expo push (send-push). Access token: expo.dev → Access tokens (bật "Enhanced security for push" thì bắt buộc)
EXPO_ACCESS_TOKEN=
# Chỉ để test local với server giả lập; bỏ trống = https://exp.host/--/api/v2/push/send
EXPO_PUSH_URL=
