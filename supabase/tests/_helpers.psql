-- Helper cho test pgTAP. Không phải file test (đuôi .psql nên pg_prove bỏ qua).
-- Mỗi file test gọi `\ir _helpers.psql` ngay sau `begin;` — mọi thứ rollback cùng transaction.
--
--   tests.create_user('user_a')                 tạo auth.users (trigger tạo profiles), role 'user'
--   tests.create_user('mod', 'moderator')       … với vai trò moderator / admin
--   tests.ban_user('bad')                       đặt profiles.is_banned = true
--   tests.authenticate_as('user_a')             role authenticated + JWT claims của user đó
--   tests.clear_auth()                          về role anon
--   tests.get_uid('user_a')                     uuid của user test
--   reset role;                                 quay về postgres để chuẩn bị dữ liệu giữa các bước
--
-- SĐT test: 8491000xxxx (không trùng user seed 8490000000x).

create extension if not exists pgtap with schema extensions;
create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

create table if not exists tests.users (identifier text primary key, id uuid not null);
grant select on tests.users to anon, authenticated;

create or replace function tests.create_user(p_identifier text, p_role text default 'user')
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
  v_n int := (select count(*) from tests.users) + 1;
begin
  insert into auth.users (id, instance_id, aud, role, phone, phone_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
          '8491000' || lpad(v_n::text, 4, '0'), now(),
          jsonb_build_object('provider', 'phone'),
          jsonb_build_object('full_name', 'Test ' || p_identifier), now(), now());
  insert into tests.users (identifier, id) values (p_identifier, v_id);
  if p_role <> 'user' and to_regclass('public.profiles') is not null then
    execute 'update public.profiles set role = $1 where id = $2' using p_role, v_id;
  end if;
  return v_id;
end;
$$;

create or replace function tests.ban_user(p_identifier text)
returns void
language plpgsql
security definer
set search_path = ''
as $$
begin
  execute 'update public.profiles set is_banned = true where id = $1'
    using (select id from tests.users where identifier = p_identifier);
end;
$$;

create or replace function tests.get_uid(p_identifier text)
returns uuid
language sql
stable
security definer
set search_path = ''
as $$ select id from tests.users where identifier = p_identifier $$;

create or replace function tests.authenticate_as(p_identifier text)
returns void
language plpgsql
as $$
declare
  v_id uuid := tests.get_uid(p_identifier);
begin
  if v_id is null then
    raise exception 'tests.authenticate_as: chưa có user "%" (gọi tests.create_user trước)', p_identifier;
  end if;
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    json_build_object('sub', v_id, 'role', 'authenticated', 'aal', 'aal1')::text, true);
end;
$$;

create or replace function tests.clear_auth()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;
